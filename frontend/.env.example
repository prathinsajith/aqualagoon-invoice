# ============================================================
#  Aqua Lagoon — Admin Frontend (Next.js) environment
#  Copy to `.env.local` and adjust. NEXT_PUBLIC_* values are inlined into
#  the client bundle at build time.
# ============================================================

# Base URL of the backend API. All data is fetched from here.
NEXT_PUBLIC_API_URL=http://localhost:8800

# Public marketing website URL — used by the "View live site" button
# in the Website management area.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3333

# Optional: extra host allowed for Next image optimization (e.g. a CDN).
# NEXT_PUBLIC_MEDIA_HOST=cdn.example.com
