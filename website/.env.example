# ============================================================
#  Aqua Lagoon — Public Website (Next.js) environment
#  Copy to `.env.local` and adjust. NEXT_PUBLIC_* values are inlined at build.
# ============================================================

# Backend API origin. All site content (homepage, services, gallery, pricing,
# timetable, contact, enquiries) is fetched from here.
NEXT_PUBLIC_API_URL=http://localhost:8800

# Public origin of THIS website — used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph tags. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://aqualagoon.in

# Launch moment shown by the /coming-soon countdown (ISO date-time).
NEXT_PUBLIC_LAUNCH_DATE=2026-09-01T09:00:00

# Pre-launch gate: set to "true" to serve the /coming-soon holding page for the
# whole site (all routes). Leave unset/false for normal operation. Server-side
# only (not NEXT_PUBLIC) — change it and redeploy to flip the site on/off.
SITE_COMING_SOON=false
