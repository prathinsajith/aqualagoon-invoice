# Copy to .env and fill in real values.

# PostgreSQL connection string used by Prisma (CLI + runtime adapter).
DATABASE_URL="postgresql://aqualagoon:aqualagoon@localhost:5432/aqualagoon?schema=public"

# HTTP server
PORT=8800
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# pretty | json — controls log output format
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGIN="http://localhost:3300"

# --- Auth -------------------------------------------------------------------
# Signing secrets — generate your own with `openssl rand -base64 48`.
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_RESET_TTL="30m"

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR="uploads"
UPLOAD_URL_PREFIX="/uploads"
# PUBLIC_URL="http://localhost:8800"

# --- Login rate limiting ----------------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW="1 minute"

# --- Seed (consumed only by `pnpm db:seed`) ---------------------------------
# Required: the first admin's credentials and the company display name/email.
# No code defaults — the seeder fails fast if these are unset. Use a strong
# admin password in production and change it after first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-strong-password"
SEED_COMPANY_NAME="Aqua Lagoon"
SEED_COMPANY_TAGLINE="Swimming Pool"
SEED_COMPANY_EMAIL="hello@aqualagoon.com"
# Optional: set to "true" to also seed sample catalog + a demo trainer (NEVER in prod).
# SEED_SAMPLES=false

# --- AWS S3 (optional) ------------------------------------------------------
# Set all four to store uploads in S3; leave blank to use local disk uploads.
# NEVER commit real credentials — keep them in your gitignored .env only.
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Optional CDN / custom-domain base (no trailing slash), e.g. https://cdn.example.com
# AWS_S3_PUBLIC_URL=

# --- Frontend URL (used to build links inside emails) -----------------------
FRONTEND_URL="http://localhost:3300"

# --- Email (optional) -------------------------------------------------------
# Configure sending one of three ways (checked in this order):
#  1) Generic SMTP — set SMTP_HOST (+ port/secure/user/pass). Works with any SMTP.
#  2) Resend      — EMAIL_PROVIDER="resend" + RESEND_API_KEY.  ← RECOMMENDED
#  3) Gmail       — EMAIL_PROVIDER="gmail" + GMAIL_USER + GMAIL_APP_PASSWORD.
# If none is set, emails are logged to the console in dev when
# EMAIL_DEV_FALLBACK=true (set false to skip sending instead).
#
# ── RECOMMENDED: Resend (reliable, sends from your own domain) ──────────────
# To use Resend, set these THREE:
#     EMAIL_PROVIDER=resend
#     RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx   (from resend.com/api-keys)
#     EMAIL_FROM=no-reply@aqualagoon.in            (MUST be on a domain you've
#                                                   VERIFIED in Resend → Domains;
#                                                   a gmail.com address will NOT work)
# Then set EMAIL_FROM_NAME below and leave the Gmail vars blank.
#
# ── Gmail (quick, but ~500/day limit + spam risk; not for production) ────────
#     EMAIL_PROVIDER=gmail
#     GMAIL_USER=you@gmail.com
#     GMAIL_APP_PASSWORD=16-char-app-password       (Google Account → App passwords)
#     EMAIL_FROM=you@gmail.com                       (Gmail can only send as this account)
#
# Generic SMTP (leave blank unless using a custom SMTP server):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional explicit sender; otherwise composed from EMAIL_FROM_NAME + EMAIL_FROM.
# (Leave blank to let it compose "EMAIL_FROM_NAME <EMAIL_FROM>" automatically.)
MAIL_FROM=
EMAIL_PROVIDER=resend
# Paste your real key here (from resend.com/api-keys) — do NOT commit it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=
GMAIL_APP_PASSWORD=
# For Resend this must be on a domain verified in Resend (e.g. no-reply@aqualagoon.in).
# For Gmail this must be the authenticated Gmail address.
EMAIL_FROM=no-reply@aqualagoon.in
EMAIL_FROM_NAME=Aqua Lagoon
EMAIL_DEV_FALLBACK=true

# --- Enquiry / booking notifications ----------------------------------------
# New website contact/booking submissions notify the business by email and
# (optionally) WhatsApp with the visitor's details.
# Email recipient — your business inbox (falls back to the site's contact email,
# then EMAIL_FROM, when unset).
ENQUIRY_NOTIFY_EMAIL=you@yourbusiness.com
# WhatsApp alerts via the Meta WhatsApp Cloud API — set ALL THREE to enable.
#   WHATSAPP_TOKEN     : permanent access token from Meta
#   WHATSAPP_PHONE_ID  : your WhatsApp Business phone-number ID
#   WHATSAPP_NOTIFY_TO : recipient number, international format (e.g. 919876543210)
# NOTE: free-form text needs an open 24h window (the recipient messages the
#       business number first) or an approved message template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_TO=
# --- Website ISR revalidation -----------------------------------------------
# When website content/gallery is saved, the backend pings the marketing site
# so its cached (ISR) pages refresh immediately. Set BOTH to enable.
#   WEBSITE_REVALIDATE_URL : e.g. https://aqualagoon.in/api/revalidate
#   REVALIDATE_SECRET      : must match the website's REVALIDATE_SECRET
WEBSITE_REVALIDATE_URL=
REVALIDATE_SECRET=
