# ============================================================
#  Aqua Lagoon — Public Website (Next.js) environment
#  Copy to `.env.local` and adjust. NEXT_PUBLIC_* values are inlined at build.
# ============================================================

# Backend API origin. All site content (homepage, services, gallery, pricing,
# timetable, contact, enquiries) is fetched from here.
NEXT_PUBLIC_API_URL=http://localhost:8800

# Public origin of THIS website — used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph tags. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://aqualagoon.in

# Launch moment shown by the /coming-soon countdown (ISO date-time).
NEXT_PUBLIC_LAUNCH_DATE=2026-09-01T09:00:00

# Pre-launch gate: set to "true" to serve the /coming-soon holding page for the
# whole site (all routes). Leave unset/false for normal operation. Server-side
# only (not NEXT_PUBLIC) — change it and redeploy to flip the site on/off.
SITE_COMING_SOON=false

# Search-engine ownership verification — paste the codes from Google Search
# Console and Bing Webmaster Tools, then redeploy. Both optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=9cgrNg8rXfcGvGVnQ61qP8NOCaOf2PrRStYisoQp2uM
NEXT_PUBLIC_BING_SITE_VERIFICATION=7832870bf48e200a957310db905a827a

# Microsoft Clarity project ID — free heatmaps + session recordings. Optional;
# falls back to the baked-in project. Find it in the Clarity dashboard URL.
NEXT_PUBLIC_CLARITY_ID=xhc2qttknk

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX) — visitor/traffic analytics.
# Optional; falls back to the baked-in property.
NEXT_PUBLIC_GA_ID=G-TCDGT6KBQQ

# Shared secret for on-demand cache revalidation. The backend sends this so
# admin content edits refresh the cached pages immediately. Generate with
# `openssl rand -hex 32`. If unset, /api/revalidate is disabled.
REVALIDATE_SECRET=
